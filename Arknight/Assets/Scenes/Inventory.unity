    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 36
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 45
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u2460 \uC81C\uC791\uAC1C\uC218 : \uC544\uC774\uD15C\uC744 \uD574\uB2F9
    \uAC1C\uC218\uB9CC\uD07C \uC81C\uC791\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n\u2461
    \uB0A8\uC740 \uC218\uC9D1\uAC1C\uC218 : \uD574\uB2F9 \uAC1C\uC218 \uB9CC\uD07C
    \uC7AC\uB8CC\uAC00 \uB354 \uD544\uC694\uD569\uB2C8\uB2E4.\n\n\uC644\uC131 \uD0DC\uADF8\uAC00
    \uB2EC\uB9B0 \uC544\uC774\uD15C\uC740 \uB354\uC774\uC0C1 \uC218\uC9D1\uD558\uC9C0
    \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.\n\n\uB4DC\uB78D \uD0DC\uADF8\uAC00 \uB2EC\uB9B0
    \uC544\uC774\uD15C\uC740 \uC81C\uC791\uC774 \uBD88\uAC00\uB2A5 \uD569\uB2C8\uB2E4.\n\n\u203B\uC8FC\uC758\u203B\n\u25C6
    \uC7AC\uB8CC\uC758 \uC81C\uC791 \uC5EC\uBD80\uB294 \uC544\uC774\uD15C \uC21C\uC11C\uB300\uB85C
    \uACC4\uC0B0\uB429\uB2C8\uB2E4.\n\u25C6 \uB0A8\uC740 \uC218\uC9D1 \uAC1C\uC218\uB294
    \uC544\uC774\uD15C\uC758 \uBCF4\uC720\uC0C1\uD0DC\uC5D0 \uB530\uB77C \uBCC0\uB3D9\uB429\uB2C8\uB2E4.\n\u25C6
    \uC544\uC774\uD15C\uC758 \uC81C\uC791\uAC1C\uC218\uB294 \uD544\uC694\uD55C \uAC1C\uC218\uB97C
    \uCD08\uACFC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n"
